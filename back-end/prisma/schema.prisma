generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum MessageType {
  text
  image
  story_reply
  reaction
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  username       String   @unique
  name           String?
  profilePicture String?
  bio            String?
  links          String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // relations
  posts          Post[]
  comments       Comment[]
  commentReplies CommentReply[]
  sentMessages   Message[]                 @relation("sentMessages")
  conversations  ConversationParticipant[]
  stories        Story[]
  notifications  NotificationUser[]
  // followers / followings (many-to-many through Follow)
  followers      Follow[]                  @relation("followed")
  following      Follow[]                  @relation("following")
  // saved posts (many-to-many)
  savedPosts     SavedPost[]

  @@index([username])
}

model Post {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String?
  description String?
  posterImage String? // posterImage in your types
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // denormalized counters (optional, update via triggers or app logic)
  likesCount    Int @default(0)
  commentsCount Int @default(0)

  author         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments       Comment[]
  commentReplies CommentReply[]
  savedBy        SavedPost[]

  @@index([userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likesCount   Int @default(0)
  repliesCount Int @default(0)

  post    Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies CommentReply[]

  @@index([postId])
  @@index([userId])
}

model CommentReply {
  id        Int      @id @default(autoincrement())
  commentId Int
  postId    Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likesCount Int @default(0)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([postId])
  @@index([userId])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followed", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model SavedPost {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Notification {
  id           Int      @id @default(autoincrement())
  action       String
  previewImage String?
  followBack   Boolean  @default(false)
  createdAt    DateTime @default(now())

  users NotificationUser[]

  @@index([createdAt])
}

model NotificationUser {
  id             Int      @id @default(autoincrement())
  notificationId Int
  userId         Int // user involved in the notification (could be actor or target)
  isActor        Boolean  @default(false) // optional flag to identify actor vs target
  createdAt      DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([userId])
}

model Conversation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isMuted   Boolean  @default(false)

  participants ConversationParticipant[]
  messages     Message[]

  @@index([createdAt])
}

model ConversationParticipant {
  id             Int      @id @default(autoincrement())
  conversationId Int
  userId         Int
  unreadCount    Int      @default(0)
  isOnline       Boolean  @default(false)
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             Int         @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String?
  imageUrl       String? // for image messages
  storyReply     String? // optional serialized info
  type           MessageType @default(text)
  isRead         Boolean     @default(false)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Story {
  id        Int       @id @default(autoincrement())
  userId    Int
  hasNew    Boolean   @default(true)
  imageUrl  String?
  noteText  String?
  isNote    Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
