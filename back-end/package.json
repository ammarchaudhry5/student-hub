{
  "name": "back-end",
  "version": "1.0.0",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "format": "prettier --write \"src/**/*.{ts,js,json,css,md}\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "mikro-orm-esm": "mikro-orm-esm"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.1",
    "@mikro-orm/postgresql": "^6.6.1",
    "@mikro-orm/reflection": "^6.6.1",
    "@mikro-orm/seeder": "^6.6.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.1",
    "@mikro-orm/migrations": "^6.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
