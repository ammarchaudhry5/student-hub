{
  "name": "back-end",
  "version": "1.0.0",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --exec tsx src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "format": "prettier --write \"src/**/*.{ts,js,json,css,md}\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "mikro-orm": "mikro-orm",
    "migration:create": "pnpm run build && pnpm mikro-orm migration:create --initial",
    "schema:update": "pnpm run build && pnpm mikro-orm schema:update --run"
  },
  "dependencies": {
    "@mikro-orm/core": "^5.9.8",
    "@mikro-orm/migrations": "^5.9.8",
    "@mikro-orm/postgresql": "^5.9.8",
    "@mikro-orm/reflection": "^5.9.8",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^5.9.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
